{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P1 early-loop icon source recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "groups"],
  "properties": {
    "schema_version": {"const": 1},
    "groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "layout", "sprites"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string", "minLength": 1},
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rows", "cols"],
            "properties": {"rows": {"type": "integer", "minimum": 1}, "cols": {"type": "integer", "minimum": 1}}
          },
          "palette": {"$ref": "#/$defs/palette"},
          "palette_quantization": {"type": "integer", "minimum": 1, "maximum": 12, "default": 12},
          "colorkey": {"$ref": "#/$defs/color"},
          "key_scope": {"enum": ["edge_connected", "all"], "default": "edge_connected"},
          "tolerance": {"type": "number", "minimum": 60, "maximum": 100},
          "sprites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source_rect"],
              "properties": {
                "id": {"type": "string"},
                "source_rect": {"$ref": "#/$defs/rect"},
                "visible_bbox": {"anyOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
                "palette": {"$ref": "#/$defs/palette"},
                "palette_quantization": {"type": "integer", "minimum": 1, "maximum": 12},
                "colorkey": {"$ref": "#/$defs/color"},
                "key_scope": {"enum": ["edge_connected", "all"]},
                "tolerance": {"type": "number", "minimum": 60, "maximum": 100}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rect": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 4, "maxItems": 4},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "palette": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/color"}}
  }
}
